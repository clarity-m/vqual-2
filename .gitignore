# The simulator itself (4.7 GB, vendor binary, redownloadable). Lives in this folder
# only because that is where it was unpacked.
AI-GP Simulator*/

# Flight recordings: hundreds of thousands of JPEGs, gigabytes. Never in git.
# If a frame is worth keeping, copy it into pilot/evidence/ — that is what it is for.
#
# EXCEPTION: the VQ1 telemetry CSVs are tracked, added deliberately with `git add -f`
# (see pilot/sessions/README.md). They are ~127 MB of text that compresses ~22x, and they
# are what the plant fit is built from. This rule still ignores everything else here, so
# a new session is NOT committed by accident — force-add it if you want it tracked.
pilot/sessions/

# Archives used to move recordings off the CAEN VM
*.tar
*.zip

__pycache__/
*.pyc
.venv/

# Fork/worktree scratch space — never part of the project tree
.claude/worktrees/

# Frame-labelling working dirs from perception/labelgates.py: annotated PNGs regenerable
# from the recordings in one command. The filled-in labels.json IS worth keeping -- copy it
# to pilot/perception/ and commit it there, since it is hand-made and cannot be regenerated.
label-*/

# Derived perception outputs, regenerable from tracked inputs:
#   autolabels_vq1.json  <- autolabel.py + the tracked VQ1 telemetry CSVs + gate truth
#                           (projection needs pose and gate centres, NOT the JPEGs)
#   verify_autolabel/    <- overlay sheets, rendered on demand
pilot/perception/autolabels_vq1.json
pilot/perception/verify_autolabel/

# Training checkpoints: ~38 MB of .pt per run, regenerable from gatenet.py + autolabel.py.
# The RESULTS live in perception/TRAINING.md, which is tracked; the weights are not.
pilot/perception/gatenet_runs/

# Pre-rendered crop cache for gatenet training (packcrops.py). 4.4 GB of uint8 tiles,
# rebuildable in ~45 s from the frames + autolabels_vq1.json. Never in git.
pilot/perception/crop_cache*/
